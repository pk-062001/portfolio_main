---
import Icon from './Icon.astro';
import Split from './Split.astro';
import { site } from '@/data/site';
---

<section class="hero" id="top" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-lines"></div>
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <a href="/#contact" class="status" data-reveal>
        <span class="pulse-dot"></span>
        {site.availability}
        <Icon name="arrow-right" size={14} />
      </a>

      <h1>
        <span class="kicker mono" data-reveal style="--d:80">{site.name} — {site.role}</span>
        <Split class="headline" style="--d:120">
          I design, ship <span class="amp">&</span> run <em class="serif">production systems</em> end-to-end.
        </Split>
      </h1>

      <p class="intro" data-reveal style="--d:420">{site.intro}</p>

      <div class="ctas" data-reveal style="--d:540">
        <a class="btn btn-primary" href="/#work" data-magnetic>
          See selected work <Icon name="arrow-up-right" class="arrow" />
        </a>
        <a class="btn" href={site.resume} download data-magnetic>
          <Icon name="download" /> Download résumé
        </a>
      </div>

      <dl class="meta" data-reveal style="--d:660">
        <div>
          <dt>Currently</dt>
          <dd>{site.currently.role} @ BXI</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>Mumbai · <span data-local-time>IST</span></dd>
        </div>
        <div>
          <dt>Core stack</dt>
          <dd>MERN · AWS · Payments</dd>
        </div>
      </dl>
    </div>

    <figure class="visual" data-portrait>
      <div class="visual-ring" aria-hidden="true"></div>
      <img
        class="fallback"
        src="/portrait-map.png"
        alt={`Halftone portrait of ${site.name}`}
        width="160"
        height="127"
        fetchpriority="low"
      />
      <canvas aria-hidden="true"></canvas>
      <figcaption class="caption mono">
        <span>fig.01 — {site.shortName}, rendered live</span>
        <span class="count"><span data-particle-count>WebGL</span> particles</span>
      </figcaption>
    </figure>
  </div>

  <a class="scroll-cue mono" href="/#about" aria-label="Scroll to about section">
    <span class="line" aria-hidden="true"></span> Scroll
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 7.5rem 5rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 45%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 45%, #000 20%, transparent 75%);
    opacity: 0.55;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
  }

  .glow-a {
    width: 70vmax;
    height: 70vmax;
    right: -20vmax;
    top: -10vmax;
    background: radial-gradient(closest-side, var(--glow), transparent);
  }

  .glow-b {
    width: 50vmax;
    height: 50vmax;
    left: -22vmax;
    bottom: -20vmax;
    background: radial-gradient(closest-side, rgba(124, 156, 255, 0.08), transparent);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1.75rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.9rem 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.8125rem;
    transition:
      border-color 0.3s,
      color 0.3s;
  }

  .status:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  h1 {
    display: grid;
    gap: 1.1rem;
  }

  .kicker {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .headline {
    display: block;
    font-size: clamp(2.75rem, 7.2vw, 5.75rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .headline em {
    color: var(--accent);
    font-size: 1.06em;
    letter-spacing: -0.03em;
  }

  .amp {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--text-muted);
  }

  .intro {
    max-width: 36rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.7;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    width: 100%;
  }

  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .meta dd {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }

  .visual {
    position: relative;
    aspect-ratio: 1 / 1.02;
    width: 100%;
    max-width: 580px;
    justify-self: end;
  }

  .visual-ring {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    border: 1px dashed var(--border-strong);
    opacity: 0.5;
    animation: spin 60s linear infinite;
  }

  .visual-ring::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 18px var(--accent);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .visual canvas,
  .fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .fallback {
    object-fit: contain;
    object-position: center 46%;
    padding: 4% 4% 0;
    image-rendering: auto;
    opacity: 0;
    transition: opacity 0.8s;
    mask-image:
      radial-gradient(circle, #000 1.15px, transparent 1.7px), linear-gradient(to bottom, #000 70%, transparent 98%);
    mask-size:
      5px 5px,
      100% 100%;
    mask-composite: intersect;
    -webkit-mask-image:
      radial-gradient(circle, #000 1.15px, transparent 1.7px), linear-gradient(to bottom, #000 70%, transparent 98%);
    -webkit-mask-size:
      5px 5px,
      100% 100%;
    -webkit-mask-composite: source-in;
    filter: sepia(1) saturate(2.6) hue-rotate(-18deg) brightness(1.05) contrast(1.15);
  }

  :global([data-theme='light']) .fallback {
    filter: grayscale(1) contrast(1.3) brightness(0.8);
  }

  .visual.is-live canvas {
    opacity: 1;
  }

  .visual.is-fallback .fallback {
    opacity: 1;
  }

  .caption {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .caption > span:first-child {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .visual.is-fallback .count {
    display: none;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .scroll-cue .line {
    position: relative;
    width: 2.5rem;
    height: 1px;
    background: var(--border-strong);
    overflow: hidden;
  }

  .scroll-cue .line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-items: start;
      padding-top: 5.5rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .visual {
      order: -1;
      justify-self: center;
      width: min(100%, 420px);
      aspect-ratio: 1 / 0.92;
    }

    .scroll-cue {
      display: none;
    }
  }
</style>

<script>
  import { site } from '@/data/site';

  const time = document.querySelector('[data-local-time]');
  if (time) {
    const fmt = new Intl.DateTimeFormat('en-IN', { timeZone: site.timezone, hour: '2-digit', minute: '2-digit', hour12: true });
    const tick = () => (time.textContent = `${fmt.format(new Date())} IST`);
    tick();
    setInterval(tick, 30_000);
  }

  const visual = document.querySelector<HTMLElement>('[data-portrait]');
  const canvas = visual?.querySelector('canvas');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  type NetworkInfo = { saveData?: boolean; effectiveType?: string };
  const nav = navigator as Navigator & { connection?: NetworkInfo; deviceMemory?: number };
  const slowNetwork = !!nav.connection && (nav.connection.saveData || /(^|-)2g$/.test(nav.connection.effectiveType ?? ''));
  const lowEnd = (nav.hardwareConcurrency ?? 4) <= 2 || (nav.deviceMemory ?? 4) <= 1;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fallback = () => visual?.classList.add('is-fallback');

  const start = async () => {
    if (!visual || !canvas || !hero) return;
    try {
      const { mountPortrait } = await import('@/scripts/particle-portrait');
      const portrait = await mountPortrait({
        canvas,
        mapUrl: '/portrait-map.png',
        theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark',
        scrollContainer: hero,
        reducedMotion,
      });
      visual.classList.add('is-live');
      const counter = visual.querySelector('[data-particle-count]');
      if (counter) counter.textContent = portrait.count.toLocaleString('en-IN');
      window.addEventListener('themechange', (e) => portrait.setTheme((e as CustomEvent).detail));
    } catch {
      fallback();
    }
  };

  if (slowNetwork || lowEnd) {
    fallback();
  } else {
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1200 }) : setTimeout(cb, 300);
    if (document.readyState === 'complete') idle(start);
    else window.addEventListener('load', () => idle(start), { once: true });
  }
</script>
