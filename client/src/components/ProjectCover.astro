---
import { Image } from 'astro:assets';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
  sizes?: string;
}

const { project, eager = false, sizes = '(max-width: 900px) 100vw, 1100px' } = Astro.props;
const { cover, coverAlt, title, accent, mock } = project.data;
---

<div class="cover" style={`--pa:${accent}`}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? `${title} screenshot`}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="shot"
      />
    ) : (
      <div class={`mock mock-${mock}`} role="img" aria-label={`Illustration of the ${title} interface`}>
        <div class="window">
          <div class="bar">
            <i />
            <i />
            <i />
            <span class="url mono">{project.id}.app</span>
          </div>
          <div class="screen">
            {mock === 'dashboard' && (
              <>
                <aside class="side">
                  <b class="logo" />
                  {Array.from({ length: 6 }, (_, i) => (
                    <span class={i === 1 ? 'nav on' : 'nav'} />
                  ))}
                </aside>
                <div class="main">
                  <div class="kpis">
                    {['92%', '148', '12'].map((v) => (
                      <div class="kpi">
                        <span class="k-label" />
                        <span class="k-value">{v}</span>
                      </div>
                    ))}
                  </div>
                  <div class="panel chart">
                    <svg viewBox="0 0 300 90" preserveAspectRatio="none" aria-hidden="true">
                      <defs>
                        <linearGradient id={`g-${project.id}`} x1="0" x2="0" y1="0" y2="1">
                          <stop offset="0" stop-color={accent} stop-opacity="0.45" />
                          <stop offset="1" stop-color={accent} stop-opacity="0" />
                        </linearGradient>
                      </defs>
                      <path d="M0 70 C30 60 45 66 70 50 S115 58 140 38 185 44 210 26 255 34 300 12 V90 H0Z" fill={`url(#g-${project.id})`} />
                      <path d="M0 70 C30 60 45 66 70 50 S115 58 140 38 185 44 210 26 255 34 300 12" fill="none" stroke={accent} stroke-width="2" />
                    </svg>
                  </div>
                  <div class="split">
                    <div class="panel map">
                      <span class="geo" />
                      <span class="pin p1" />
                      <span class="pin p2" />
                      <span class="pin p3" />
                    </div>
                    <div class="panel rows">
                      {Array.from({ length: 4 }, () => (
                        <span class="row" />
                      ))}
                    </div>
                  </div>
                </div>
              </>
            )}
            {mock === 'chat' && (
              <>
                <aside class="side people">
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class={i === 0 ? 'person on' : 'person'}>
                      <b />
                      <span />
                      {i < 3 && <em />}
                    </span>
                  ))}
                </aside>
                <div class="main thread">
                  <span class="msg in w60" />
                  <span class="msg out w45" />
                  <span class="msg in w70" />
                  <span class="msg out w55" />
                  <span class="msg in w35 typing">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="composer" />
                </div>
              </>
            )}
            {mock === 'marketplace' && (
              <div class="main listings">
                <span class="search" />
                <div class="tiles">
                  {Array.from({ length: 6 }, (_, i) => (
                    <div class="tile">
                      <span class={`ph ph${i % 3}`} />
                      <span class="line" />
                      <span class="line short" />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(70% 80% at 70% 0%, color-mix(in srgb, var(--pa) 26%, transparent), transparent 70%),
      var(--bg-elev);
  }

  .shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .mock {
    position: absolute;
    inset: 9% 7% -6%;
    transition: transform 0.9s var(--ease-out);
  }

  :global(.project:hover) .mock {
    transform: translateY(-3%) scale(1.015);
  }

  .window {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .url {
    margin-left: auto;
    margin-right: auto;
    padding: 0.15rem 0.9rem;
    border-radius: 6px;
    background: var(--surface-strong);
    color: var(--text-dim);
    font-size: 0.6rem;
  }

  .screen {
    flex: 1;
    display: flex;
    min-height: 0;
  }

  .side {
    width: 22%;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 0.9rem 0.7rem;
    border-right: 1px solid var(--border);
  }

  .logo {
    width: 40%;
    height: 10px;
    border-radius: 4px;
    background: var(--pa);
    margin-bottom: 0.5rem;
  }

  .nav {
    height: 8px;
    border-radius: 4px;
    background: var(--surface-strong);
  }

  .nav.on {
    background: color-mix(in srgb, var(--pa) 55%, transparent);
  }

  .main {
    flex: 1;
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem;
    align-content: start;
    min-width: 0;
  }

  .panel {
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }

  .kpi {
    display: grid;
    gap: 0.35rem;
    padding: 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .k-label {
    width: 50%;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-strong);
  }

  .k-value {
    font-size: clamp(0.7rem, 1.6vw, 1rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .chart {
    height: 5.5rem;
    padding: 0.5rem 0;
  }

  .chart svg {
    width: 100%;
    height: 100%;
  }

  .split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0.6rem;
  }

  .map {
    position: relative;
    height: 5rem;
    overflow: hidden;
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 10px 10px;
  }

  .geo {
    position: absolute;
    left: 30%;
    top: 20%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed var(--pa);
    background: color-mix(in srgb, var(--pa) 14%, transparent);
  }

  .pin {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pa);
    box-shadow: 0 0 10px var(--pa);
  }

  .p1 {
    left: 44%;
    top: 40%;
  }

  .p2 {
    left: 60%;
    top: 58%;
  }

  .p3 {
    left: 18%;
    top: 66%;
    background: var(--text-dim);
    box-shadow: none;
  }

  .rows {
    display: grid;
    gap: 0.45rem;
    padding: 0.6rem;
    align-content: start;
  }

  .row {
    height: 8px;
    border-radius: 4px;
    background: var(--surface-strong);
  }

  .row:first-child {
    width: 70%;
    background: color-mix(in srgb, var(--pa) 40%, transparent);
  }

  .person {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem;
    border-radius: 8px;
  }

  .person.on {
    background: var(--surface-strong);
  }

  .person b {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--pa) 45%, var(--surface-strong));
  }

  .person span {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-strong);
  }

  .person em {
    position: absolute;
    left: 1.15rem;
    top: 1.15rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fd0a4;
    border: 2px solid var(--bg);
  }

  .thread {
    align-content: end;
    gap: 0.5rem;
  }

  .msg {
    height: 1.3rem;
    border-radius: 10px;
    background: var(--surface-strong);
  }

  .msg.out {
    justify-self: end;
    background: var(--pa);
    opacity: 0.85;
  }

  .w35 {
    width: 35%;
  }
  .w45 {
    width: 45%;
  }
  .w55 {
    width: 55%;
  }
  .w60 {
    width: 60%;
  }
  .w70 {
    width: 70%;
  }

  .typing {
    width: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .typing i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-dim);
    animation: blink 1.4s infinite;
  }

  .typing i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing i:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .composer {
    height: 1.7rem;
    margin-top: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
  }

  .search {
    height: 1.6rem;
    width: 60%;
    justify-self: center;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  .tile {
    display: grid;
    gap: 0.35rem;
  }

  .ph {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
  }

  .ph0 {
    background: linear-gradient(135deg, color-mix(in srgb, var(--pa) 70%, transparent), color-mix(in srgb, var(--pa) 15%, transparent));
  }

  .ph1 {
    background: linear-gradient(135deg, var(--surface-strong), color-mix(in srgb, var(--pa) 35%, transparent));
  }

  .ph2 {
    background: linear-gradient(135deg, color-mix(in srgb, #7c9cff 40%, transparent), var(--surface-strong));
  }

  .line {
    height: 6px;
    border-radius: 3px;
    background: var(--surface-strong);
  }

  .line.short {
    width: 55%;
  }
</style>
