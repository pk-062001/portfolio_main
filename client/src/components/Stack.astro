---
import Split from './Split.astro';
import { skillGroups } from '@/data/skills';
---

<section class="section" id="stack" aria-labelledby="stack-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-reveal>Stack</span>
      <Split as="h2" class="section-title" id="stack-title">
        Tools I reach for to ship <em class="serif">reliably</em>.
      </Split>
      <p class="section-lead" data-reveal>
        Grouped by the problems they solve, not by logo. Everything here has been used in production or a shipped project.
      </p>
    </div>

    <ul class="bento">
      {
        skillGroups.map((group, i) => (
          <li class:list={['card', 'spotlight', 'group', { featured: group.featured }]} data-reveal style={`--d:${(i % 3) * 80}`}>
            <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <p>{group.blurb}</p>
            <ul class="chips">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .group {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 1.75rem;
    transition: border-color 0.4s;
  }

  .group:hover {
    border-color: var(--border-strong);
  }

  .featured {
    grid-column: span 2;
    background:
      radial-gradient(90% 120% at 100% 0%, var(--glow), transparent 60%),
      var(--surface);
  }

  .featured h3 {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }

  .idx {
    font-size: 0.72rem;
    color: var(--accent);
  }

  h3 {
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }

  p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 0.5rem;
  }

  .chips {
    list-style: none;
    padding: 0;
  }

  .group:last-child {
    border-style: dashed;
  }

  @media (min-width: 1001px) {
    .group:last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 1000px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .featured {
      grid-column: auto;
    }
  }
</style>
