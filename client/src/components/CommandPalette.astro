---
import type { ComponentProps } from 'astro/types';
import Icon from './Icon.astro';
import { nav, site } from '@/data/site';
import { getProjects } from '@/lib/projects';

const projects = await getProjects();

type Command = {
  group: string;
  label: string;
  icon: ComponentProps<typeof Icon>['name'];
  action: 'link' | 'external' | 'copy' | 'download' | 'theme';
  value: string;
};

const commands: Command[] = [
  ...nav.map((item): Command => ({ group: 'Navigate', label: item.label, icon: 'arrow-right', action: 'link', value: item.href })),
  ...projects.map((p): Command => ({ group: 'Case studies', label: p.data.title, icon: 'layers', action: 'link', value: `/work/${p.id}` })),
  { group: 'Actions', label: 'Copy email address', icon: 'copy', action: 'copy', value: site.email },
  { group: 'Actions', label: 'Download résumé', icon: 'download', action: 'download', value: site.resume },
  { group: 'Actions', label: 'Toggle light / dark theme', icon: 'sun', action: 'theme', value: '' },
  { group: 'Links', label: 'GitHub', icon: 'github', action: 'external', value: site.github },
  { group: 'Links', label: 'LinkedIn', icon: 'linkedin', action: 'external', value: site.linkedin },
];

const groups = [...new Set(commands.map((c) => c.group))];
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="box">
    <label class="search">
      <Icon name="search" size={18} />
      <input type="text" placeholder="Type a command or search…" autocomplete="off" spellcheck="false" data-palette-input aria-label="Search commands" />
      <kbd class="mono">esc</kbd>
    </label>
    <div class="list" role="listbox" data-palette-list>
      {
        groups.map((group) => (
          <div class="group" data-group>
            <p class="group-label mono">{group}</p>
            {commands
              .filter((c) => c.group === group)
              .map((c) => (
                <button
                  type="button"
                  class="item"
                  role="option"
                  data-item
                  data-action={c.action}
                  data-value={c.value}
                  data-search={`${c.label} ${c.group}`.toLowerCase()}
                >
                  <Icon name={c.icon} size={16} />
                  <span>{c.label}</span>
                  <Icon name="arrow-right" size={14} class="go" />
                </button>
              ))}
          </div>
        ))
      }
      <p class="empty" data-palette-empty hidden>No results.</p>
    </div>
  </div>
</dialog>

<style>
  .palette {
    width: min(560px, calc(100% - 2rem));
    max-height: min(520px, 80vh);
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--bg-elev);
    color: var(--text);
    box-shadow: 0 40px 120px -20px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .palette[open] {
    animation: pop 0.35s var(--ease-out);
  }

  .palette::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
  }

  .search input {
    flex: 1;
    border: 0;
    background: none;
    outline: none;
    font-size: 1rem;
    color: var(--text);
  }

  kbd {
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    font-size: 0.7rem;
  }

  .list {
    overflow-y: auto;
    padding: 0.5rem;
    overscroll-behavior: contain;
  }

  .group-label {
    padding: 0.7rem 0.7rem 0.35rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem;
    border-radius: 10px;
    color: var(--text-muted);
    text-align: left;
    font-size: 0.95rem;
  }

  .item :global(.go) {
    margin-left: auto;
    opacity: 0;
  }

  .item.active {
    background: var(--surface-strong);
    color: var(--text);
  }

  .item.active :global(.go) {
    opacity: 1;
    color: var(--accent);
  }

  .item[hidden],
  .group[hidden] {
    display: none;
  }

  .empty {
    padding: 1.5rem;
    text-align: center;
    color: var(--text-dim);
  }
</style>

<script>
  import { scrollToHash, toggleTheme } from '@/scripts/motion';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const items = [...dialog.querySelectorAll<HTMLButtonElement>('[data-item]')];
  const groups = [...dialog.querySelectorAll<HTMLElement>('[data-group]')];
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  let active = 0;

  const visible = () => items.filter((i) => !i.hidden);
  const highlight = (index: number) => {
    const list = visible();
    if (!list.length) return;
    active = (index + list.length) % list.length;
    items.forEach((i) => i.classList.remove('active'));
    list[active].classList.add('active');
    list[active].scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const q = input.value.trim().toLowerCase();
    items.forEach((i) => (i.hidden = !!q && !i.dataset.search!.includes(q)));
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-item]:not([hidden])')));
    empty.hidden = visible().length > 0;
    highlight(0);
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    filter();
    dialog.showModal();
    window.dispatchEvent(new CustomEvent('scroll-lock'));
    input.focus();
  };
  const close = () => {
    if (!dialog.open) return;
    dialog.close();
    window.dispatchEvent(new CustomEvent('scroll-unlock'));
  };
  dialog.addEventListener('close', () => window.dispatchEvent(new CustomEvent('scroll-unlock')));

  const run = (item: HTMLButtonElement) => {
    const { action, value = '' } = item.dataset;
    close();
    if (action === 'link') {
      const url = new URL(value, location.href);
      if (url.pathname !== location.pathname || !url.hash) {
        location.href = value;
        return;
      }
      requestAnimationFrame(() => {
        scrollToHash(url.hash);
      });
    } else if (action === 'external') window.open(value, '_blank', 'noopener');
    else if (action === 'copy') navigator.clipboard?.writeText(value);
    else if (action === 'download') {
      const a = Object.assign(document.createElement('a'), { href: value, download: '' });
      a.click();
    } else if (action === 'theme') toggleTheme();
  };

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    }
  });
  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));
  dialog.addEventListener('click', (e) => e.target === dialog && close());
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const current = visible()[active];
      if (current) run(current);
    }
  });
  items.forEach((item) => {
    item.addEventListener('click', () => run(item));
    item.addEventListener('pointermove', () => highlight(visible().indexOf(item)));
  });
</script>
