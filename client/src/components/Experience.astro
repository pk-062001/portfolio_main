---
import Icon from './Icon.astro';
import Split from './Split.astro';
import { education, experience } from '@/data/experience';

const rich = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-reveal>Experience</span>
      <Split as="h2" class="section-title" id="experience-title">
        Shipping in <em class="serif">production,</em>not just in demos.
      </Split>
      <p class="section-lead" data-reveal>
        Payments, security and platforms that real businesses depend on — owned from design through deployment.
      </p>
    </div>

    <div class="timeline-wrap" data-timeline>
    <span class="rail" aria-hidden="true"><span class="rail-fill" data-rail></span></span>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li class="role" data-reveal>
            <div class="when">
              <span class="period mono">{job.period}</span>
              {job.current && (
                <span class="now mono">
                  <span class="pulse-dot" /> Now
                </span>
              )}
              <span class="where mono">{job.location}</span>
            </div>

            <article class="body">
              <header>
                <h3>{job.role}</h3>
                <p class="company">
                  {job.companyUrl ? (
                    <a href={job.companyUrl} target="_blank" rel="noopener noreferrer">
                      {job.company} <Icon name="arrow-up-right" size={14} />
                    </a>
                  ) : (
                    job.company
                  )}
                </p>
              </header>

              <p class="context">{job.context}</p>

              <ul class="wins">
                {job.wins.map((win) => (
                  <li set:html={rich(win)} />
                ))}
              </ul>

              {job.products && (
                <div class="products">
                  {job.products.map((product) => (
                    <a class="product card spotlight" href={product.url} target="_blank" rel="noopener noreferrer">
                      <span class="product-name">
                        {product.name} <Icon name="arrow-up-right" size={14} />
                      </span>
                      <span class="product-blurb">{product.blurb}</span>
                    </a>
                  ))}
                </div>
              )}

              <div class="chips">
                {job.stack.map((tech) => (
                  <span class="chip">{tech}</span>
                ))}
              </div>
            </article>
          </li>
        ))
      }

      <li class="role edu" data-reveal>
        <div class="when">
          <span class="period mono">{education.period}</span>
          <span class="where mono">Education</span>
        </div>
        <article class="body">
          <header>
            <h3>{education.degree}</h3>
            <p class="company">{education.school}</p>
          </header>
          <p class="context">{education.note} — foundations in data structures, databases, operating systems and networks.</p>
        </article>
      </li>
    </ol>
    </div>
  </div>
</section>

<style>
  .timeline-wrap {
    position: relative;
  }

  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .rail {
    position: absolute;
    top: 0.4rem;
    bottom: 0;
    left: calc(13rem + 0.5px);
    width: 1px;
    background: var(--border);
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--accent), var(--accent-soft));
    transform-origin: top;
    transform: scaleY(var(--progress, 0));
  }

  .role {
    position: relative;
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
  }

  .role::before {
    content: '';
    position: absolute;
    left: calc(13rem - 5px);
    top: 0.35rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .when {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.5rem;
    padding-right: 2rem;
  }

  .period {
    font-size: 0.8rem;
    color: var(--text);
  }

  .where {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #3fd0a4;
  }

  .body {
    display: grid;
    gap: 1.25rem;
    padding-left: clamp(1.75rem, 4vw, 3rem);
  }

  .body h3 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .company {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .company a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.3s;
  }

  .company a:hover {
    color: var(--accent);
  }

  .context {
    max-width: 44rem;
    color: var(--text-muted);
  }

  .wins {
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
    padding: 0;
    list-style: none;
  }

  .wins li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .wins li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.6rem;
    height: 1px;
    background: var(--accent);
  }

  .wins :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 46rem;
  }

  .product {
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem;
    transition: border-color 0.3s;
  }

  .product:hover {
    border-color: var(--border-strong);
  }

  .product-name {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .product-blurb {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .rail {
      left: 5px;
    }

    .role {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding-left: 1.75rem;
    }

    .role::before {
      left: 0;
    }

    .when {
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
      gap: 0.9rem;
      padding-right: 0;
    }

    .body {
      padding-left: 0;
    }

    .products {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (timeline && rail) {
    let ticking = false;
    const update = () => {
      const rect = timeline.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (innerHeight * 0.6 - rect.top) / rect.height));
      rail.style.setProperty('--progress', progress.toFixed(3));
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) requestAnimationFrame(update);
        ticking = true;
      },
      { passive: true },
    );
    update();
  }
</script>
