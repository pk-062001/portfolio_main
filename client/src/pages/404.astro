---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Split from '@/components/Split.astro';
---

<Base title="Page not found" noindex>
  <section class="container lost">
    <p class="code mono">404</p>
    <Split as="h1">This route <em class="serif">doesn't exist</em> — yet.</Split>
    <p class="muted">The page you're looking for has moved or never shipped. Let's get you back on track.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/">Back home <Icon name="arrow-right" class="arrow" /></a>
      <a class="btn" href="/#work">See my work</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 90svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    padding-top: 6rem;
  }

  .code {
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 6rem);
    letter-spacing: -0.05em;
    max-width: 14ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
