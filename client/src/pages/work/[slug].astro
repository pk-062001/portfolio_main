---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Split from '@/components/Split.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import { getProjects, type Project } from '@/lib/projects';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const url = `${site.url}/work/${project.id}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    headline: d.tagline,
    description: d.summary,
    url,
    dateCreated: d.year,
    keywords: d.stack.join(', '),
    author: { '@type': 'Person', name: site.name, url: site.url },
    ...(d.live ? { sameAs: d.live } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/#work` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];

const meta = [
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Year', value: d.year },
  { label: 'Status', value: d.status },
].filter((m) => m.value);
---

<Base title={`${d.title} — case study`} description={`${d.tagline} ${d.summary}`.slice(0, 300)} type="article" jsonLd={jsonLd}>
  <article class="case" style={`--pa:${d.accent}`}>
    <header class="container head">
      <a href="/#work" class="back mono" data-reveal><Icon name="arrow-left" size={14} /> All work</a>
      <span class="eyebrow" data-reveal>Case study · {d.year}</span>
      <Split as="h1">{d.title}</Split>
      <p class="tagline" data-reveal>{d.tagline}</p>
    </header>

    <div class="container" data-reveal>
      <div class="cover-wrap card">
        <ProjectCover project={project} eager sizes="(max-width: 1240px) 100vw, 1200px" />
      </div>
    </div>

    <div class="container body">
      <aside class="side">
        <dl>
          {
            meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
        <div>
          <p class="side-label mono">Stack</p>
          <div class="chips">
            {d.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
        {
          (d.live || d.repo) && (
            <div class="links">
              {d.live && (
                <a class="btn btn-primary" href={d.live} target="_blank" rel="noopener noreferrer">
                  Visit live <Icon name="arrow-up-right" class="arrow" />
                </a>
              )}
              {d.repo && (
                <a class="btn" href={d.repo} target="_blank" rel="noopener noreferrer">
                  <Icon name="github" /> Source
                </a>
              )}
            </div>
          )
        }
      </aside>

      <div class="main">
        <p class="summary">{d.summary}</p>
        <ul class="highlights">
          {d.highlights.map((h) => <li class="card">{h}</li>)}
        </ul>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    {
      next.id !== project.id && (
        <nav class="container next" aria-label="Next case study">
          <a href={`/work/${next.id}`} class="next-link card spotlight" style={`--pa:${next.data.accent}`}>
            <span class="mono">Next case study</span>
            <span class="next-title">
              {next.data.title} <Icon name="arrow-right" size={28} />
            </span>
            <span class="muted">{next.data.tagline}</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .case {
    padding-top: 8.5rem;
  }

  .head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .back:hover {
    color: var(--text);
  }

  h1 {
    font-size: clamp(3.25rem, 11vw, 8.5rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .tagline {
    max-width: 40rem;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    color: var(--text-muted);
    letter-spacing: -0.02em;
  }

  .cover-wrap {
    border-radius: var(--radius-lg);
  }

  .body {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .side {
    position: sticky;
    top: 6.5rem;
    align-self: start;
    display: grid;
    gap: 2rem;
  }

  .side dl {
    display: grid;
    gap: 1.1rem;
  }

  .side dt,
  .side-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.3rem;
  }

  .side dd {
    margin: 0;
  }

  .side-label {
    margin-bottom: 0.75rem;
  }

  .links {
    display: grid;
    gap: 0.6rem;
  }

  .summary {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 2.5rem 0 1rem;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    padding: 1.1rem 1.2rem 1.1rem 2.4rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 1.55rem;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--pa);
  }

  .next {
    padding-bottom: var(--section);
  }

  .next-link {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    transition: border-color 0.4s;
  }

  .next-link:hover {
    border-color: color-mix(in srgb, var(--pa) 45%, var(--border));
  }

  .next-link .mono {
    font-size: 0.75rem;
    color: var(--pa);
  }

  .next-title {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .next-title :global(svg) {
    transition: transform 0.5s var(--ease-out);
  }

  .next-link:hover .next-title :global(svg) {
    transform: translateX(8px);
  }

  @media (max-width: 900px) {
    .case {
      padding-top: 6.5rem;
    }

    .body {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
      order: 2;
    }
  }

  @media (max-width: 560px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
